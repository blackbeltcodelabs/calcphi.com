<a href="#main-content" class="skip-link">Skip to main content</a>

<div class="cp-header-wrap">
  <!-- Announcement strip -->
  <div class="cp-announce">
    <span class="hide-mobile">All calculations run in your browser.</span>
    No login required.
    <span class="cp-announce-sep">·</span>
    Updated for AY 2026-27
  </div>

  <!-- Main header bar -->
  <header class="cp-header">
    <div class="cp-header__bar">

      <!-- Logo -->
      <a href="/" class="cp-logo" aria-label="CalcPhi — Financial Calculators">
        <span class="cp-logo-tile">φ</span>
        <span class="cp-logo-wm">Calc<em>Phi</em></span>
      </a>

      <!-- Primary nav -->
      {% if page.url != "/" %}
      <nav class="cp-nav" aria-label="Primary navigation">
        <a id="nav-calc-link"
           href="{% if page.url.startsWith('/australia/') %}/australia/{% elif page.url.startsWith('/usa/') %}/usa/{% else %}/india/{% endif %}"
           {% if page.url.startsWith('/india/') or page.url.startsWith('/australia/') or page.url.startsWith('/usa/') %}aria-current="true"{% endif %}>
          Calculators
        </a>
        <a href="/markets/"
           {% if page.url.startsWith('/markets/') %}aria-current="page"{% endif %}>
          Markets
        </a>
        <a id="nav-blog-link"
           href="{% if page.url.startsWith('/australia/') %}/australia/blog/{% else %}/india/blog/{% endif %}"
           {% if page.url.startsWith('/australia/blog/') or page.url.startsWith('/india/blog/') %}aria-current="page"{% endif %}>
          Blog
        </a>
        <a id="nav-help-link"
           href="{% if page.url.startsWith('/australia/') %}/australia/help/{% elif page.url.startsWith('/india/') %}/india/help/{% else %}/help/{% endif %}"
           {% if page.url.startsWith('/australia/help/') or page.url.startsWith('/india/help/') or page.url.startsWith('/help/') %}aria-current="page"{% endif %}>
          Help
        </a>
        <a href="/about/"
           {% if page.url.startsWith('/about/') %}aria-current="page"{% endif %}>
          About
        </a>
        <a href="/contact/"
           {% if page.url.startsWith('/contact/') %}aria-current="page"{% endif %}>
          Contact
        </a>
      </nav>
      {% endif %}

      <div style="flex:1"></div>

      <!-- Search -->
      <button id="cp-search-btn" class="cp-search-btn" aria-label="Search calculators" aria-haspopup="dialog">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
        </svg>
        <span>Search calculators…</span>
        <span class="cp-search-spacer"></span>
        <kbd class="cp-search-kbd">⌘K</kbd>
      </button>

      <!-- Market picker -->
      <details class="cp-market">
        <summary aria-label="Choose market">
          <span class="cp-market-label">🌐 Select Country</span>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </summary>
        <div class="cp-market-dropdown">
          <a href="/australia/" data-market-code="AU">🇦🇺 <strong>Australia</strong> · AUD</a>
          <a href="/india/" data-market-code="IN">🇮🇳 <strong>India</strong> · INR</a>
          <span class="cp-market-item--soon">🇺🇸 <strong>USA</strong> · USD <span class="cp-soon-badge">Soon</span></span>
          <span class="cp-market-item--soon">🇨🇦 <strong>Canada</strong> · CAD <span class="cp-soon-badge">Soon</span></span>
        </div>
      </details>

      <!-- Mobile toggle -->
      <button class="cp-mobile-toggle" aria-label="Toggle navigation" id="nav-toggle" aria-expanded="false" aria-controls="cp-mobile-nav">
        <span class="cp-ham">
          <span></span><span></span><span></span>
        </span>
      </button>

    </div>

    <!-- Mobile nav (hidden by default) -->
    <nav id="cp-mobile-nav" class="cp-mobile-nav" aria-label="Mobile navigation" hidden>
      <a id="mob-calc-link" href="{% if page.url.startsWith('/australia/') %}/australia/{% elif page.url.startsWith('/usa/') %}/usa/{% else %}/india/{% endif %}">Calculators</a>
      <a href="/markets/">Markets</a>
      <a id="mob-blog-link" href="{% if page.url.startsWith('/australia/') %}/australia/blog/{% else %}/india/blog/{% endif %}">Blog</a>
      <a id="mob-help-link" href="{% if page.url.startsWith('/australia/') %}/australia/help/{% elif page.url.startsWith('/india/') %}/india/help/{% else %}/help/{% endif %}">Help</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <div class="cp-mobile-nav__markets">
        <a href="/australia/" data-market-code="AU">🇦🇺 Australia</a>
        <a href="/india/" data-market-code="IN">🇮🇳 India</a>
        <span class="cp-mobile-nav__market--soon">🇺🇸 USA <span class="cp-soon-badge">Soon</span></span>
        <span class="cp-mobile-nav__market--soon">🇨🇦 Canada <span class="cp-soon-badge">Soon</span></span>
      </div>
    </nav>
  </header>
</div>

<script>
(function() {
  var btn = document.getElementById('nav-toggle');
  var nav = document.getElementById('cp-mobile-nav');
  if (btn && nav) {
    btn.addEventListener('click', function() {
      var open = nav.hasAttribute('hidden');
      if (open) { nav.removeAttribute('hidden'); btn.setAttribute('aria-expanded', 'true'); }
      else { nav.setAttribute('hidden', ''); btn.setAttribute('aria-expanded', 'false'); }
    });
  }

  // Dynamic nav links — rewrite Calculators, Blog, Help based on detected market
  (function() {
    var path = window.location.pathname;
    var market = null;
    if (path.startsWith('/australia/')) market = 'AU';
    else if (path.startsWith('/india/')) market = 'IN';
    if (market) {
      try { localStorage.setItem('cp_market', market); } catch(e) {}
    } else {
      try { market = localStorage.getItem('cp_market'); } catch(e) {}
    }

    // Map each nav link to its market-specific URL
    var navMap = {
      calc: { AU: '/australia/', IN: '/india/' },
      blog: { AU: '/australia/blog/', IN: '/india/blog/' },
      help: { AU: '/australia/help/', IN: '/india/help/' }
    };

    function setHref(id, url) {
      var el = document.getElementById(id);
      if (el && url) el.href = url;
    }

    if (market) {
      setHref('nav-calc-link', navMap.calc[market]);
      setHref('nav-blog-link', navMap.blog[market]);
      setHref('nav-help-link', navMap.help[market]);
      setHref('mob-calc-link', navMap.calc[market]);
      setHref('mob-blog-link', navMap.blog[market]);
      setHref('mob-help-link', navMap.help[market]);
    }

    // Persist market on dropdown link clicks and immediately update nav links
    document.querySelectorAll('[data-market-code]').forEach(function(el) {
      el.addEventListener('click', function() {
        var code = el.getAttribute('data-market-code');
        try { localStorage.setItem('cp_market', code); } catch(e) {}
      });
    });
  })();
})();
</script>
