<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-94D5DND9LS"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-94D5DND9LS');
</script>

<!-- Self-hosted fonts — preload the two most LCP-critical files -->
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/source-serif4-regular-latin.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/geist-latin.woff2" crossorigin>

<title>{{ title }}{% if "CalcPhi" not in title %} | CalcPhi{% endif %}</title>
<meta name="description" content="{{ description }}">

<link rel="canonical" href="{{ site.url }}{{ permalink }}">
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ permalink }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage if ogImage else site.defaultOgImage }}">
<meta property="og:site_name" content="CalcPhi">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.url }}{{ ogImage if ogImage else site.defaultOgImage }}">

<!-- Hreflang — auto-generated from market + permalink -->
{% if market == "india" %}
<link rel="alternate" hreflang="en-in"    href="{{ site.url }}{{ permalink }}">
<link rel="alternate" hreflang="en-au"    href="{{ site.url }}/australia/">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}/india/">
{% elif market == "australia" %}
<link rel="alternate" hreflang="en-au"    href="{{ site.url }}{{ permalink }}">
<link rel="alternate" hreflang="en-in"    href="{{ site.url }}/india/">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}/australia/">
{% else %}
<link rel="alternate" hreflang="en-in"    href="{{ site.url }}/india/">
<link rel="alternate" hreflang="en-au"    href="{{ site.url }}/australia/">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}/">
{% endif %}
{% if hreflang %}
  {% for h in hreflang %}
  <link rel="alternate" hreflang="{{ h.lang }}" href="{{ site.url }}{{ h.url }}">
  {% endfor %}
{% endif %}

<!-- Language -->
<meta name="language" content="en">

<!-- Critical CSS inlined -->
{% inlineCss "critical.css" %}

<!-- Main stylesheet -->
<link rel="stylesheet" href="/assets/css/main.css?v=10">

<!-- Favicon (inline SVG data URI) -->
<link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">

<!-- Per-page schema is injected by the layout into <body> -->
