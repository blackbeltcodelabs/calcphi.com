<!DOCTYPE html>
<html lang="en">
<head>
  {% include "components/head.njk" %}
  {% if breadcrumbs and breadcrumbs | length > 0 %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [{% for crumb in breadcrumbs %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ crumb.name | dump | safe }}{% if crumb.url %},"item":"{{ site.url }}{{ crumb.url }}"{% endif %}}{% if not loop.last %},{% endif %}{% endfor %}]
  }
  </script>
  {% endif %}
</head>
<body>
  {% include "components/header.njk" %}
  {% include "components/geo-banner.njk" %}
  {% include "components/breadcrumb.njk" %}

  {{ content | safe }}

  {% include "components/footer.njk" %}
  <script src="/assets/js/geo.js" defer></script>
  <script src="/assets/js/search.js" defer></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.faq-q').forEach(function(q) {
        q.addEventListener('click', function() {
          var item = q.closest('.faq-item');
          var isOpen = item.classList.contains('is-open');
          item.closest('.faq-list, .faq-section') && item.closest('.faq-list, .faq-section').querySelectorAll('.faq-item').forEach(function(i) { i.classList.remove('is-open'); });
          if (!isOpen) item.classList.add('is-open');
        });
      });
    });
  </script>
</body>
</html>
