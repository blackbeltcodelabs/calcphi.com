<script>
// Save market preference when user clicks a live market card
document.querySelectorAll('.mkt-card--live[data-market-code]').forEach(function(el) {
  el.addEventListener('click', function() {
    try { localStorage.setItem('cp_market', el.getAttribute('data-market-code')); } catch(e) {}
  });
});
</script>
