        <tr><td>Minimum contribution</td><td>₹42–₹1,454/month</td><td>₹500/month (Tier 1)</td></tr>
        <tr><td>Lock-in</td><td>Until age 60</td><td>Until age 60 (partial withdrawals allowed)</td></tr>
        <tr><td>Tax benefit</td><td>80CCD(1) — within ₹1.5L 80C limit</td><td>80CCD(1) + extra ₹50,000 under 80CCD(1B)</td></tr>
