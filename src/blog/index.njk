---
layout: layouts/base.njk
permalink: /india/blog/
title: "India Personal Finance Blog | CalcPhi"
description: "In-depth guides on income tax, SIP returns, NPS, FD, term insurance, home loans, and retirement planning for India. Real numbers, current rules, no jargon — written by CFAs, CAs, and CFPs."
breadcrumbs:
  - name: Home
    url: /
  - name: India
    url: /india/
  - name: Blog
---

<main id="main-content">
  <div class="hub-hero">
    <div class="hub-hero__inner">
      <h1>India Personal Finance Blog</h1>
      <p>{{ collections.indiaBlog | length }} guides covering income tax, mutual funds, FD, NPS, term insurance, home loans, and retirement planning. Real numbers, current regulations, written by CFAs, CAs, and CFPs.</p>
    </div>
  </div>

  <div class="hub-content">

    <div id="blog-filters" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:2rem;">
      <button class="blog-filter-btn blog-filter-btn--active" data-category="all">All &mdash; {{ collections.indiaBlog | length }}</button>
      <button class="blog-filter-btn" data-category="Tax">Tax</button>
      <button class="blog-filter-btn" data-category="Investing">Investing</button>
      <button class="blog-filter-btn" data-category="Savings">Savings</button>
      <button class="blog-filter-btn" data-category="Retirement">Retirement</button>
      <button class="blog-filter-btn" data-category="Real Estate">Real Estate</button>
      <button class="blog-filter-btn" data-category="Salary">Salary</button>
      <button class="blog-filter-btn" data-category="Loans">Loans</button>
      <button class="blog-filter-btn" data-category="Insurance">Insurance</button>
    </div>

    <div class="blog-grid" id="blog-grid">

      {% for post in collections.indiaBlog %}
        {% set slug = post.url | replace("/india/blog/", "") | replace("/", "") %}
        {% set meta = india.blogMeta[slug] %}
        {% set cardTitle = post.data.cardTitle or meta.cardTitle or post.data.title | replace(" | CalcPhi", "") %}
        {% set cardSummary = post.data.cardSummary or meta.cardSummary or post.data.description %}
        {% set displayCategory = post.data.category or meta.category or "General" %}
        <article class="blog-card">
          <div class="blog-card__meta">
            <span class="blog-card__tag">{{ displayCategory }}</span>
            <span class="blog-card__date">{{ post.data.datePublished | monthYear }}</span>
            {% if post.data.dateModified and post.data.dateModified != post.data.datePublished %}
            <span class="blog-card__updated">Updated {{ post.data.dateModified | monthYear }}</span>
            {% endif %}
          </div>
          <h2><a href="{{ post.url }}">{{ cardTitle }}</a></h2>
          <p>{{ cardSummary }}</p>
          <a href="{{ post.url }}" class="blog-card__read">Read article →</a>
        </article>
      {% endfor %}

    </div>
  </div>
</main>

<style>
.blog-filter-btn {
  display: inline-block;
  padding: 0.3rem 0.85rem;
  border-radius: 2rem;
  font-size: 0.8rem;
  font-weight: 600;
  background: var(--color-muted);
  border: 1px solid var(--color-border);
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
}
.blog-filter-btn:hover {
  background: var(--color-border);
  color: var(--color-text);
}
.blog-filter-btn--active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}
</style>

<script>
(function () {
  const btns = document.querySelectorAll('.blog-filter-btn');
  const cards = document.querySelectorAll('#blog-grid .blog-card');

  btns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      const cat = btn.dataset.category;

      btns.forEach(function (b) { b.classList.remove('blog-filter-btn--active'); });
      btn.classList.add('blog-filter-btn--active');

      cards.forEach(function (card) {
        if (cat === 'all') {
          card.style.display = '';
        } else {
          const tag = card.querySelector('.blog-card__tag');
          card.style.display = (tag && tag.textContent.trim() === cat) ? '' : 'none';
        }
      });
    });
  });
})();
</script>
