        </p>
        <p class="author-bio-card__title">{{ author.title }}</p>
        <p class="author-bio-card__bio">{{ author.shortBio }}</p>
        <a href="{{ author.url }}" class="author-bio-card__profile-link">View full profile →</a>
      </div>
    </div>

  </div>
</main>
